{
  "name": "projectplanner",
  "private": true,
  "type": "module",
  "version": "0.1.0",
  "dependencies": {
    "@cloudflare/workers-oauth-provider": "^1.2.3",
    "@modelcontextprotocol/sdk": "^1.32.1",
    "@xyflow/react": "^12.12.0",
    "agents": "^0.28.1",
    "hono": "^4.13.13",
    "postal-mime": "4.0.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "^1.4.2",
    "@playwright/test": "1.56.1",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^4.1.11",
    "wrangler": "^4.151.0"
  },
  "scripts": {
    "dev": "wrangler dev",
    "build:client": "vite build",
    "build": "wrangler deploy --dry-run --outdir dist/worker",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "check": "npm run typecheck && npm test && npm run build",
    "types": "wrangler types",
    "db:migrate:local": "wrangler d1 migrations apply DB --local",
    "deploy": "sh scripts/deploy.sh"
  },
  "engines": {
    "node": ">=20"
  }
}
